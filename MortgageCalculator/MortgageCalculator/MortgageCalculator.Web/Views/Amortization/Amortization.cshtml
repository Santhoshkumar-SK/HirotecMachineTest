@model MortgageCalculator.Dto.MortgagewithCalculationDto
@{
    ViewBag.Title = "Monthly Amortization Schedule";
}

<div style="margin-top:80px">
    @Html.ActionLink("GoBack", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
</div>
<h2>Monthly Amortization Schedule</h2>
<div class="row">
    <div class="col-md-12">       
        <fieldset>
            <legend>Mortgage Details</legend>

            <div>
                <label class="col-md-2 control-label" for="mortgagename">Mortgage Name</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label" for="mortgagename">@Model.Mortgage.MortgageName</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label">Principle Amount</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label">@Model.Mortgage.PrincipalAmount</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label">Rate of Interest</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label">@Model.Mortgage.RateofInterest</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label">Terms in Year</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label">@Model.Mortgage.TermsInYears</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label">Start Date</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label">@Model.Mortgage.InterestDetails.EffectiveStartDate</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label">End Date</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label">@Model.Mortgage.InterestDetails.EffectiveEndDate</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label">Mortage Type</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label">@Model.Mortgage.InterestDetails.MortgageType.ToString()</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label">Repayment Type</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label">@Model.Mortgage.InterestDetails.InterestRepayment.ToString()</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label">Total Interest</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label">@Model.TotalInterest</label>
                </div>
            </div>
            <div>
                <label class="col-md-2 control-label" for="mortgagename">Total Repayment Amount</label>
                <div class="col-md-10">
                    <label class="col-md-4 control-label" for="mortgagename">@Model.TotalRepaymentAmount</label>
                </div>
            </div>
        </fieldset>
    </div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Payment #</th>
                <th>Opening Balance</th>
                <th>EMI Amount</th>
                <th>Principal</th>
                <th>Interest</th>
                <th>Outstanding Principal</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.MonthlyAmortization != null && Model.MonthlyAmortization.Any())
            {
                foreach (var item in Model.MonthlyAmortization)
                {
                    <tr>
                        <td>@item.PaymentCount</td>
                        <td>@item.OpeningBalance.ToString("N2")</td>
                        <td>@item.EmiAmount.ToString("N2")</td>
                        <td>@item.MonthlyPrincipal.ToString("N2")</td>
                        <td>@item.MonthlyInterest.ToString("N2")</td>
                        <td>@item.OutStandingPrincipal.ToString("N2")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No amortization data available</td>
                </tr>
            }
        </tbody>
    </table>
